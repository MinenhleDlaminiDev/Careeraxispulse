# Supabase — copy this file to ".env" and fill in your own values.
# Find both under Supabase dashboard → Project Settings → API.
# Vite only exposes vars prefixed with VITE_ to the frontend.

# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...) — safe to ship in the frontend (RLS
# protects the data). This replaces the legacy anon key, which Supabase is
# retiring in 2027.
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the secret key (sb_secret_..., formerly service_role) here or
# anywhere in this repo. It bypasses Row Level Security and stays server-side only.
