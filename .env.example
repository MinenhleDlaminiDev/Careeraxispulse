# Supabase — copy this file to ".env" and fill in your own values.
# Find both under Supabase dashboard → Project Settings → API.
# Vite only exposes vars prefixed with VITE_ to the frontend.

# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...) — safe to ship in the frontend (RLS
# protects the data). This replaces the legacy anon key, which Supabase is
# retiring in 2027.
VITE_SUPABASE_PUBLISHABLE_KEY=

# AXIS-43 — Google sign-in. Leave false until Google is actually enabled under
# Supabase → Authentication → Providers → Google, and the site URL is listed
# under Authentication → URL Configuration → Redirect URLs.
#
# Why a flag: a disabled provider does NOT come back as an error. Supabase
# answers the redirect with raw JSON ("Unsupported provider: provider is not
# enabled") that the client is stranded on, so the button is hidden until this
# says true.
VITE_GOOGLE_AUTH=false

# NEVER put the secret key (sb_secret_..., formerly service_role) here or
# anywhere in this repo. It bypasses Row Level Security and stays server-side only.
